.page { padding: 24rpx; }
.card { padding: 24rpx; border-radius: 20rpx; background: #fff; border: 1rpx solid #dfe8f3; box-shadow: 0 10rpx 26rpx rgba(15,23,42,.05); }
.title { color: #0d2b4f; font-size: 34rpx; font-weight: 700; margin-bottom: 20rpx; }
.result-item { padding: 14rpx 12rpx; border-radius: 12rpx; background: #f8fbff; margin-bottom: 12rpx; }
.label { display: block; color: #64748b; font-size: 22rpx; }
.value { display: block; color: #0d2b4f; font-weight: 700; font-size: 36rpx; margin-top: 8rpx; }
.value.small { font-size: 24rpx; }
.info-box { margin-top: 18rpx; padding: 12rpx; border-radius: 10rpx; background: #fff7ed; color: #8a5a12; line-height: 1.7; font-size: 22rpx; }
