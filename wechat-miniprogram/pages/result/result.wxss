.page { padding: 24rpx; }
.card { background: #fff; border: 1rpx solid #e1eaf5; border-radius: 20rpx; padding: 24rpx; box-shadow: 0 10rpx 26rpx rgba(15,23,42,.05); }
.title { color: #0d2b4f; font-size: 34rpx; font-weight: 700; margin-bottom: 20rpx; }
.block { margin-bottom: 16rpx; padding: 14rpx 12rpx; background: #f8fbff; border-radius: 12rpx; }
.label { display: block; color: #64748b; font-size: 22rpx; }
.value { display: block; margin-top: 8rpx; color: #0d2b4f; font-weight: 700; font-size: 32rpx; }
.info { background: #fff7ed; color: #8a5a12; }
