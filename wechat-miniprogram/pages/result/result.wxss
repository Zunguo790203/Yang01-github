.page { padding: 24rpx; }
.card { background: #fff; border: 1rpx solid #dfe8f3; border-radius: 20rpx; padding: 24rpx; box-shadow: 0 10rpx 26rpx rgba(15,23,42,.05); }
.title { color: #0d2b4f; font-size: 34rpx; font-weight: 700; margin-bottom: 18rpx; }
.result-item { background: #f8fbff; border: 1rpx solid #dfe8f3; border-radius: 12rpx; padding: 14rpx 12rpx; margin-bottom: 12rpx; }
.label { display: block; font-size: 22rpx; color: #64748b; }
.value { display: block; margin-top: 8rpx; font-size: 36rpx; font-weight: 700; color: #0d2b4f; }
.value.small { font-size: 24rpx; }
