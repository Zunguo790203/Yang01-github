<view class="page">
  <view class="card">
    <view class="title">计算结果</view>
    <view class="block">
      <text class="label">名义环空流速</text>
      <text class="value">{{annularVelocity || '--'}}</text>
    </view>
    <view class="block">
      <text class="label">ECD状态</text>
      <text class="value">{{ecdStatus || '待计算'}}</text>
    </view>
    <view class="block">
      <text class="label">井眼清洁/岩屑运移</text>
      <text class="value">{{cleanStatus || '待计算'}}</text>
    </view>
    <view class="block info">
      <text>当前页面仅展示本机缓存中的结果；完整工程模型仍需现场校验和审批。</text>
    </view>
  </view>
</view>
