<view class="page">
  <view class="hero">
    <view class="hero-title">钻井现场辅助</view>
    <view class="hero-sub">第 4 版：按工程字段分组、数据校验和结果边界</view>
    <view class="hero-tag">原型 · 工程边界清晰</view>
  </view>

  <view class="panel" wx:for="{{groupNames}}" wx:key="*this">
    <view class="group-title">{{groups[item] && groups[item][0] ? groups[item][0].label : '字段组'}}</view>
    <view wx:for="{{groups[item] || []}}" wx:key="key" class="field-row">
      <text>{{item.label}}</text>
      <input value="{{form[item.key] || ''}}" data-key="{{item.key}}" bindinput="onInput" placeholder="{{item.unit || ''}}" />
    </view>
  </view>

  <view class="actions">
    <button class="primary" bindtap="validate">校验</button>
    <button class="secondary" bindtap="save">保存</button>
  </view>

  <view class="result-box">
    <view class="row"><text>基础校验</text><text>{{validationStatus}}</text></view>
    <view class="row"><text>ECD状态</text><text>{{ecdStatus}}</text></view>
    <view class="row"><text>风险状态</text><text>{{riskState}}</text></view>
    <view class="row"><text>环空流速</text><text>{{annularVelocity}}</text></view>
    <view class="row"><text>岩屑指数</text><text>{{transportIndex}}</text></view>
  </view>

  <view class="warning-box" wx:if="{{warnings.length > 0}}">
    <view wx:for="{{warnings}}" wx:key="*this">• {{item}}</view>
  </view>
  <view class="summary-box">{{resultSummary}}</view>
</view>
