.page { padding: 24rpx; padding-bottom: 60rpx; }
.hero { padding: 30rpx 28rpx; color: #fff; border-radius: 24rpx; background: linear-gradient(135deg,#0d2b4f,#1d4f91); box-shadow: 0 12rpx 32rpx rgba(15,35,70,.15); }
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { margin-top: 10rpx; font-size: 25rpx; opacity: .85; }
.hero-tag { display: inline-block; margin-top: 18rpx; padding: 8rpx 14rpx; border-radius: 20rpx; background: rgba(255,255,255,.16); font-size: 21rpx; }
.tabs { display: flex; padding: 8rpx; margin: 20rpx 0; border-radius: 16rpx; background: #e7eef8; }
.tab { flex: 1; text-align: center; padding: 16rpx 4rpx; color: #52657a; font-size: 25rpx; border-radius: 12rpx; }
.tab.selected { color: #174987; background: #fff; font-weight: 700; box-shadow: 0 3rpx 12rpx rgba(15,35,70,.08); }
.card { margin-bottom: 20rpx; padding: 24rpx; border-radius: 20rpx; background: #fff; border: 1rpx solid #dfe8f3; box-shadow: 0 8rpx 22rpx rgba(15,23,42,.05); }
.card-title { margin-bottom: 18rpx; color: #0d2b4f; font-size: 31rpx; font-weight: 700; }
.field { display: flex; align-items: center; justify-content: space-between; min-height: 84rpx; border-bottom: 1rpx solid #edf1f6; gap: 18rpx; }
.field text { flex: 1; color: #64748b; font-size: 24rpx; }
.field input { width: 42%; padding: 12rpx 14rpx; text-align: right; color: #1f2d3d; font-size: 27rpx; background: #f8fafc; border-radius: 10rpx; }
.source { margin-top: 18rpx; color: #64748b; font-size: 22rpx; }
.actions { display: flex; gap: 12rpx; margin-top: 20rpx; flex-wrap: wrap; }
.actions button { margin: 0; flex: 1; min-width: 180rpx; font-size: 24rpx; }
.primary { color: #fff; background: #2563eb; }
.secondary { color: #174987; background: #edf4ff; }
.result-label { color: #64748b; font-size: 24rpx; }
.result-value { margin: 8rpx 0 16rpx; color: #0d2b4f; font-weight: 700; font-size: 48rpx; }
.muted { margin-top: 14rpx; color: #64748b; font-size: 22rpx; line-height: 1.6; }
.status-row { display: flex; justify-content: space-between; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid #edf1f6; font-size: 24rpx; }
.status { flex: 1; color: #805a10; text-align: right; }
.warning { padding: 12rpx; margin-top: 12rpx; color: #9a3412; background: #fff7ed; border-radius: 10rpx; font-size: 23rpx; }
.caution { color: #6b4c08; background: #fffbeb; line-height: 1.7; font-size: 24rpx; }
.caution .card-title { color: #805a10; }
.bullet { margin: 12rpx 0; color: #3c4b5c; font-size: 24rpx; line-height: 1.65; }
.caution-text { margin-top: 22rpx; padding: 16rpx; color: #991b1b; border-radius: 12rpx; background: #fff1f2; font-size: 23rpx; line-height: 1.65; }
.footer { padding: 18rpx; color: #8090a2; text-align: center; font-size: 21rpx; }
