.page { padding: 24rpx; padding-bottom: 80rpx; }
.hero { padding: 28rpx 24rpx; border-radius: 24rpx; background: linear-gradient(135deg,#0d2b4f,#1d4f91); color: #fff; box-shadow: 0 12rpx 28rpx rgba(15,35,70,.12); }
.hero-title { font-size: 38rpx; font-weight: 700; }
.hero-sub { margin-top: 10rpx; opacity: .85; font-size: 25rpx; }
.hero-tag { display: inline-block; margin-top: 18rpx; padding: 8rpx 14rpx; border-radius: 20rpx; background: rgba(255,255,255,.12); font-size: 21rpx; }
.panel { background: #fff; border: 1rpx solid #dfe8f3; border-radius: 18rpx; padding: 18rpx 16rpx; margin-top: 18rpx; }
.group-title { color: #0d2b4f; font-weight: 700; font-size: 30rpx; margin-bottom: 12rpx; }
.field-row { display: flex; align-items: center; justify-content: space-between; min-height: 80rpx; border-bottom: 1rpx solid #edf1f6; }
.field-row text { flex: 1; color: #64748b; font-size: 23rpx; }
.field-row input { width: 46%; text-align: right; background: #f8fafc; border: 1rpx solid #edf1f6; padding: 10rpx 12rpx; border-radius: 10rpx; color: #1f2d3d; font-size: 24rpx; }
.actions { display: flex; gap: 10rpx; margin-top: 20rpx; }
button { border: none; border-radius: 12rpx; padding: 14rpx 18rpx; flex: 1; }
.primary { background: #2563eb; color: #fff; }
.secondary { background: #edf4ff; color: #0d2b4f; }
.result-box { margin-top: 20rpx; background: #f8fbff; border: 1rpx solid #dfe8f3; border-radius: 14rpx; padding: 12rpx 14rpx; }
.row { display: flex; justify-content: space-between; padding: 10rpx 4rpx; font-size: 23rpx; color: #3c4b5c; }
.warning-box { margin-top: 18rpx; background: #fff7ed; color: #9a3412; border-radius: 12rpx; padding: 14rpx; line-height: 1.7; font-size: 22rpx; }
.summary-box { margin-top: 18rpx; background: #f8fbff; border: 1rpx solid #dfe8f3; border-radius: 12rpx; padding: 14rpx; line-height: 1.7; color: #1f2d3d; font-size: 22rpx; }
